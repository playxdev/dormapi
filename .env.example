# Copy to .env and fill in. Never commit .env.

APP_ENV=development

# Local listen address. Managed platforms (DigitalOcean App Platform, Cloud Run)
# inject PORT instead and route traffic to it; leave ADDR unset there.
ADDR=:8080

# Browser origins allowed to call this API. The MINI App is served from a
# different origin, so a missing entry here surfaces in the app as
# "cannot reach the system".
ALLOWED_ORIGINS=https://dorm.playxdev.com,https://dorm-mini.pages.dev,http://localhost:5173

# Where the backoffice is served. Used only to build the address of the lease a
# tenant reads before confirming - that page is rendered by the backoffice, so
# the wording the tenant sees and the wording the owner prints stay one
# document. Leave unset and the invite preview simply carries no link.
BACKOFFICE_URL=https://dormplace.pages.dev

# Numeric ID of the LINE Login channel serving the LIFF app. Every accepted
# ID token must carry this as its `aud` claim, so it must match the channel
# whose LIFF ID the frontend was built with.
#   LIFF ID 2011358311-IAdUIyFx -> channel ID 2011358311
LINE_CHANNEL_ID=2011358311

# Cloudflare D1. This is the same database the backoffice (playxdev/dormplace)
# owns and migrates; schema changes belong there, not here.
#
# The API token must be a scoped token with D1 edit permission on this account
# only - never a global API key.
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Signs the session tokens this service issues. Unrelated to any LINE
# credential. At least 32 bytes; generate with:
#   openssl rand -base64 48
JWT_SECRET=

# Public address of this API. Used to build the links inside the mails this
# service sends - a verification link points back at `GET /email/verify`, which
# is answered here rather than by the frontend.
API_BASE_URL=https://moon-app-4bony.ondigitalocean.app

# Permanent link of the LIFF app. Where a tenant is sent after a mailed link is
# consumed, since the recovery flow ends inside the app rather than on a page
# this service renders.
APP_LIFF_URL=https://liff.line.me/2011358311-IAdUIyFx

# Mail transport (Cloudflare Email Sending). With MAIL_FROM or MAIL_API_TOKEN
# unset the service starts anyway and logs every message instead of sending it,
# which is the intended local setup - but email verification and account
# recovery then reach nobody, so both must be set in production.
#
# MAIL_API_TOKEN falls back to CLOUDFLARE_API_TOKEN when unset. The address
# must be on a domain onboarded to Cloudflare Email Sending with SPF, DKIM and
# DMARC in place; mail from an unverified domain is rejected, not queued.
MAIL_FROM=no-reply@dorm.place
MAIL_FROM_NAME=dorm.place
MAIL_API_TOKEN=
