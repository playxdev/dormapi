# Copy to .env and fill in. Never commit .env.

APP_ENV=development
ADDR=:8080

# Browser origins allowed to call this API. The MINI App is served from a
# different origin, so a missing entry here surfaces in the app as
# "cannot reach the system".
ALLOWED_ORIGINS=https://dorm.playxdev.com,https://dorm-mini.pages.dev,http://localhost:5173

# Numeric prefix of the LIFF ID for the environment being served. Every
# accepted ID token must carry this as its `aud` claim.
#   Developing LIFF ID 2011361700-JZlB29PM -> channel ID 2011361700
LINE_CHANNEL_ID=2011361700

# Cloudflare D1. The API token must be a scoped token with D1 edit permission
# on this account only - never a global API key.
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Signs the session tokens this service issues. Unrelated to any LINE
# credential. At least 32 bytes; generate with:
#   openssl rand -base64 48
JWT_SECRET=
